# Copie para .env e preencha. O .env esta no .gitignore - nao versione o seu.
#
#   cp .env.example .env
#
# Todas as variaveis tem default no codigo (app/config.py) ou no
# docker-compose.yml, MENOS SECRET_KEY e EVOLUTION_API_KEY, que o compose recusa
# subir sem valor: sao as duas que viram problema de seguranca se ficarem no
# default.

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------

# Credenciais do container do Postgres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=mass_push
# Porta publicada no host. Mude se ja tiver um Postgres local ocupando a 5432.
POSTGRES_PORT=5432

# URL que a APLICACAO usa. Este valor vale para rodar no host (uvicorn direto,
# `alembic upgrade head`), com o Postgres do compose publicado em localhost.
# Dentro do compose o servico `app` sobrescreve isto para apontar ao host
# `postgres` - nao adianta mudar aqui para esse caso.
#
# O driver e "+psycopg" (psycopg 3). Sem esse sufixo o SQLAlchemy procura o
# psycopg2, que nao esta no requirements.txt.
DATABASE_URL=postgresql+psycopg://postgres:troque-esta-senha@localhost:5432/mass_push

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------

# Assina o cookie de sessao do dashboard. Quem tiver este valor consegue se
# passar por qualquer usuario logado. Gere um proprio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# "desenvolvimento" ou "producao". Em producao a aplicacao reclama em voz alta
# se SECRET_KEY ou EVOLUTION_API_KEY ainda estiverem no valor de fabrica.
AMBIENTE=desenvolvimento

# Porta publicada da aplicacao.
APP_PORT=8000

# Loga toda query SQL. Util para entender uma consulta lenta, insuportavel no
# dia a dia.
DEBUG_SQL=false

# Pool de conexoes. Mexer so se o Postgres comecar a recusar conexao.
POOL_SIZE=5
POOL_MAX_OVERFLOW=10
# Recicla conexao com mais de N segundos. Conexao ociosa derrubada pelo servidor
# so aparece como erro na proxima query, e ai o disparo ja falhou.
POOL_RECICLAR_SEG=1800

# ---------------------------------------------------------------------------
# Evolution API (o que conecta o WhatsApp pelo QR code)
# ---------------------------------------------------------------------------

# Chave mestra da Evolution: cria instancia, le QR e envia mensagem por qualquer
# numero conectado. Trate como senha de producao e nunca exponha a porta 8080
# na internet aberta. Gere um proprio:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_API_KEY=

# URL que a APLICACAO usa para falar com a Evolution, rodando no host. Dentro do
# compose o servico `app` sobrescreve para http://evolution-api:8080.
EVOLUTION_URL=http://localhost:8080

# URL pela qual a Evolution se enxerga (vai nos links que ela devolve).
EVOLUTION_URL_PUBLICA=http://localhost:8080
EVOLUTION_PORT=8080

# Como o aparelho aparece nos dispositivos conectados (User-Agent do WhatsApp Web).
EVOLUTION_NOME_CLIENTE=Chrome
# Versao do WhatsApp Web. Se o QR vier vazio (count:0), atualize com a versao
# que aparece no rodape do web.whatsapp.com e reinicie o container.
CONFIG_SESSION_PHONE_VERSION=2.3000.1023204200

# Volume do log da Evolution. Deixe em ERROR,WARN para o log nao virar ruido.
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO

# ---------------------------------------------------------------------------
# Gemini (respostas depois que o lead fala)
# ---------------------------------------------------------------------------

# Crie uma chave no Google AI Studio. Sem chave, o disparo e a inbox continuam
# funcionando, mas os modos "rascunho" e "automatica" ficam bloqueados.
GEMINI_API_KEY=
# Modelo economico e rapido; pode ser trocado sem alterar o fluxo da aplicacao.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta

# Privacidade: a modalidade gratuita pode usar o conteudo para melhorar
# produtos do Google. Use dados sinteticos nos testes e revise os termos/uma
# modalidade paga antes de enviar conversas reais de clientes.

# ---------------------------------------------------------------------------
# Webhook de retorno
# ---------------------------------------------------------------------------

# E por aqui que entrega, resposta e pedido de parar voltam da Evolution. Sem
# webhook o freio de reputacao nunca ve bloqueio nem resposta, e a campanha
# roda as cegas - ligue assim que a rota existir.
WEBHOOK_GLOBAL_ENABLED=false
# Endereco visto de DENTRO do container. Funciona com uvicorn no host e tambem
# com o profile app, que publica a porta 8000.
WEBHOOK_GLOBAL_URL=http://host.docker.internal:8000/webhook/evolution
